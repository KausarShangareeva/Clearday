# ---- Required ----
# Public URL of the app (no trailing slash). Locally: http://localhost:3000
APP_URL=http://localhost:3000
PORT=3000
# Long random string (32+ chars). Used to sign cookies and encrypt OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- AI: set ONE key. Gemini also powers the live voice assistant. ----
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
# Claude key (used when GEMINI_API_KEY is empty): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model overrides for whichever provider is active
# (defaults: Gemini gemini-3.5-flash-lite / gemini-3.8-flash; Claude claude-haiku-4-5-20251001 / claude-sonnet-5-5)
AI_MODEL=
AI_SMART_MODEL=

# ---- Google / Gmail ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft / Outlook ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = personal (outlook.com, hotmail) + work/school accounts
MICROSOFT_TENANT=common

# ---- Sync tuning ----
# Latest emails read per inbox
MAX_PER_ACCOUNT=50
# How many emails per inbox to read when analysing the whole mailbox for categories
SCAN_MAX=300

# Where encrypted tokens and AI results are stored
DATA_DIR=./data

# Set to 1 to enable a fake "Mock" provider for offline rehearsals (never in production)
DEV_MOCK=0
