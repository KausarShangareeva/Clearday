# ---- Required ----
# Public URL of the app (no trailing slash). Locally: http://localhost:3000
APP_URL=http://localhost:3000
PORT=3000
# Long random string (32+ chars). Used to sign cookies and encrypt OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- AI: set ONE key. Gemini also powers the live voice assistant. ----
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
# Claude key (used when GEMINI_API_KEY is empty): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model overrides for whichever provider is active
# (defaults: Gemini gemini-3.5-flash-lite / gemini-3.8-flash; Claude claude-haiku-4-5-20251001 / claude-sonnet-5-5)
AI_MODEL=
AI_SMART_MODEL=

# ---- Google / Gmail ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft / Outlook ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = personal (outlook.com, hotmail) + work/school accounts
MICROSOFT_TENANT=common

# ---- Sync tuning ----
# Latest emails read per inbox
MAX_PER_ACCOUNT=50
# How many emails per inbox to read when analysing the whole mailbox for categories
SCAN_MAX=300

# Where encrypted tokens and AI results are stored
DATA_DIR=./data

# Set to 1 to enable a fake "Mock" provider for offline rehearsals (never in production)
DEV_MOCK=0

# ---- Hosting for many users (all optional) ----
# Max emails analysed by AI per user per day (protects your Gemini bill)
AI_DAILY_CAP=400
# Refuse new sign-ups beyond this many users (leave empty for no limit)
MAX_USERS=
# Minimum seconds between two syncs of the same user, in milliseconds
SYNC_COOLDOWN_MS=8000

# Owner-only admin dashboard: comma-separated mailbox addresses (case-insensitive)
ADMIN_EMAILS=
# 1 = show full emails in the admin table (default: masked)
ADMIN_SHOW_EMAILS=

# ---- Condense (token compression before the LLM; https://condense.chat) ----
CONDENSE_API_KEY=
# CONDENSE_MODEL=helene-1
# LLM_PRICE_PER_MTOK_IN=0.30
