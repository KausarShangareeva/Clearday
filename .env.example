# ---- Required ----
# Public URL of the app (no trailing slash). Locally: http://localhost:3000
APP_URL=http://localhost:3000
PORT=3000
# Long random string (32+ chars). Used to sign cookies and encrypt OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Claude (AI analysis, drafts, assistant) ----
ANTHROPIC_API_KEY=
# Fast model for classifying every email; smarter model for chat and rewrites.
AI_MODEL=claude-haiku-4-5-20251001
AI_SMART_MODEL=claude-sonnet-5-5

# ---- Google / Gmail ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft / Outlook ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = personal (outlook.com, hotmail) + work/school accounts
MICROSOFT_TENANT=common

# ---- Sync tuning ----
SYNC_HOURS=72
MAX_PER_ACCOUNT=25

# Where encrypted tokens and AI results are stored
DATA_DIR=./data

# Set to 1 to enable a fake "Mock" provider for offline rehearsals (never in production)
DEV_MOCK=0
