# ---- Required ----
# Public URL of the app (no trailing slash). Locally: http://localhost:3000
APP_URL=http://localhost:3000
PORT=3000
# Long random string (32+ chars). Used to sign cookies and encrypt OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Gemini (analysis, drafts, assistant, live voice) ----
# Get a key at https://aistudio.google.com/apikey  (never commit this file)
GEMINI_API_KEY=
# Fast model classifies every email; smarter model for chat and rewrites.
AI_MODEL=gemini-3.5-flash-lite
AI_SMART_MODEL=gemini-3.8-flash
# Real-time voice assistant (Gemini Live)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore

# ---- Google / Gmail ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft / Outlook ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = personal (outlook.com, hotmail) + work/school accounts
MICROSOFT_TENANT=common

# (Clearday reads only the latest 50 inbox emails per account.)

# Where encrypted tokens and AI results are stored
DATA_DIR=./data

# Set to 1 to enable a fake "Mock" provider for offline rehearsals (never in production)
DEV_MOCK=0
